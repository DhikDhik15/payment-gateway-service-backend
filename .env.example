# Development-oriented template. For APP_ENV=production, replace all
# development placeholders and provide strong secrets/proxy/TLS settings.
APP_NAME=payment-gateway
APP_ENV=development
# Direct processes listen on this port. Docker Compose keeps the container
# listener on 8080 and publishes it on host port 8081.
APP_PORT=8080
# Browser-facing origin for mock PaymentURLs. This is the frontend origin that
# serves /pay/:identifier; it is intentionally independent from APP_PORT and the
# backend API origin. It is required when PAYMENT_PROVIDER=mock.
FRONTEND_PUBLIC_URL=http://localhost:5173
# Deprecated compatibility alias for older deployments:
# MOCK_PAYMENT_BASE_URL=http://localhost:5173

# Phase 8D.1 — Payment simulator containment (fail closed).
# Defaults to FALSE: an operator must opt in explicitly. When true,
# SIMULATOR_MERCHANT_ID is required, the simulator routes require X-API-Key
# auth, and ONLY that merchant may use them (tenant-scoped reads/writes).
# Startup FAILS if APP_ENV=production and this is true — the simulator can
# never run in production.
PAYMENT_SIMULATOR_ENABLED=false
# Merchant UUID allowed to use the simulator. Not a secret — pick a local ACTIVE merchant.
# Example (replace with a merchant id from your local DB):
# SIMULATOR_MERCHANT_ID=755ef533-1b2e-4dfd-a0d2-7ab36efbd389
SIMULATOR_MERCHANT_ID=755ef533-1b2e-4dfd-a0d2-7ab36efbd389

# ── Phase 8D.3: Legacy plaintext credential migration window ─────────────────
# Controls whether bare legacy keys (merchants.api_key, "pk_<hex>" with no
# ":sk_" segment) may still authenticate. Creation of NEW legacy credentials
# is frozen permanently regardless of this flag — POST /api/v1/merchants
# always returns 409 LEGACY_CREDENTIAL_CREATION_DISABLED.
#   unset   → development/test: true (existing merchants keep working);
#             production and any other env: FALSE (fail-safe closed default).
#   true    → migration window open: legacy keys authenticate while their
#             legacy_credential_state is LEGACY or MIGRATED.
#   false   → every bare legacy key is rejected with 401
#             LEGACY_CREDENTIALS_NOT_ENABLED before any credential lookup.
# Values are parsed strictly: anything that is not a boolean FAILS startup.
# Phase 5C compound credentials ("pk_…:sk_…") are unaffected either way.
LEGACY_API_CREDENTIALS_ENABLED=true

# ── Phase 8D.1: In-process rate limiting (fixed one-minute windows) ──────────
# Enabled by default with sensitive limits. Disabling is development/test only;
# production startup rejects RATE_LIMIT_ENABLED=false. A zero/negative
# per-minute value is REJECTED at startup (a typo can never mean "unlimited").
RATE_LIMIT_ENABLED=true
# Login attempts, per client IP AND per submitted account email.
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Admin API attempts, per client IP (counts rejected key attempts too).
RATE_LIMIT_ADMIN_PER_MINUTE=60
# Merchant API attempts, per client IP (pre-auth) and per authenticated merchant.
RATE_LIMIT_API_PER_MINUTE=120

# ── Phase 8D.2: Inbound HTTP hardening ───────────────────────────────────────
# Request body cap for every route (bytes). A declared Content-Length above
# the cap is rejected immediately with 413 REQUEST_TOO_LARGE; chunked/unknown
# bodies are hard-capped at bind time. Zero/negative values are REJECTED at
# startup — a typo can never mean "unlimited".
HTTP_MAX_BODY_BYTES=1048576
# http.Server timeouts. ReadHeaderTimeout bounds slow-header (slowloris-style)
# request attacks; Read/Write bound full request/response transfer;
# IdleTimeout reaps idle keep-alive connections. Zero/negative values are
# REJECTED at startup.
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# X-Forwarded-For trust policy (ClientIP and rate-limit keying derive from it):
#   unset/empty → allowed in development only; production startup fails until
#                 an explicit policy is supplied.
#   none        → trust NO proxy: ClientIP uses the socket peer address.
#   otherwise   → comma-separated trusted IPs/CIDRs, e.g.
#                 TRUSTED_PROXIES=172.18.0.0/16,203.0.113.10
# Invalid IP/CIDR entries fail startup (fail fast).
TRUSTED_PROXIES=none

DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=payment
DB_PASSWORD=payment
DB_NAME=payment_gateway
# Development databases commonly run without TLS. Production requires
# DB_SSLMODE=verify-full (or equivalent certificate-verified TLS).
DB_SSLMODE=disable
# Optional explicit migration URL. Set this in production/staging when a DB
# password contains URL-special characters; credentials must be URL-encoded.
# MIGRATION_DATABASE_URL=postgres://<user>:<encoded-password>@<host>:5432/<db>?sslmode=verify-full

# Provider selection. mock needs no external credentials and is rejected when
# APP_ENV=production. Production Midtrans must explicitly set its HTTPS endpoint.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_TIMEOUT=15s
IDEMPOTENCY_TTL=24h
PAYMENT_EXPIRY_ENABLED=true
PAYMENT_EXPIRY_INTERVAL=30s
PAYMENT_EXPIRY_BATCH_SIZE=100
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Mock provider HMAC secret. Required with a non-default value (at least 32
# bytes) when APP_ENV=production; blank is rejected there.
MOCK_WEBHOOK_SECRET=

# Phase 7C — internal settlement/reconciliation ops API.
# Leave empty to disable the admin routes. Never use a merchant X-API-Key here.
# When enabled in production, use a random value of at least 32 bytes.
ADMIN_API_KEY=
SETTLEMENT_RECON_STALE_AFTER=2m

# Phase 6 — outbound merchant webhooks
WEBHOOK_DELIVERY_ENABLED=true
WEBHOOK_DELIVERY_INTERVAL=5s
WEBHOOK_DELIVERY_BATCH_SIZE=20
WEBHOOK_DELIVERY_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DELIVERY_STALE_AFTER=2m
# 32-byte AES key as 64 hex chars. Generate with: openssl rand -hex 32
# Required in production; when unset outside production the app falls back to
# a development-only key (existing local encrypted webhook secrets keep working).
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Leave unset for the safe environment default (false in development, true in
# production). Explicit false is rejected when APP_ENV=production.
WEBHOOK_REQUIRE_HTTPS=

# Phase 8 — Dashboard authentication (JWT + HttpOnly refresh cookie)
# JWT signing secret. MUST be set to a strong random value of at least 32 bytes
# in production.
# Generate with: openssl rand -hex 32
# Required in production — leaving empty uses an insecure dev default (will log a warning).
AUTH_JWT_SECRET=
# Access token lifetime (short-lived). Default: 15m
AUTH_ACCESS_TOKEN_TTL=15m
# Refresh token / session lifetime (longer-lived). Default: 168h (7 days)
AUTH_REFRESH_TOKEN_TTL=168h
# Team invitation token validity (Phase 8B). Default: 48h (audit recommends 48–72h)
INVITATION_TOKEN_TTL=48h
# ── Dashboard ───────────────────────────────────────────────────────────────
# Public base URL of the dashboard SPA — used to build invitation acceptance
# links ({DASHBOARD_BASE_URL}/accept-invitation?token=...).
# Optional while EMAIL_ENABLED=false; REQUIRED when EMAIL_ENABLED=true.
# In production, any configured value must be an HTTPS origin without userinfo.
# Local development (Vite SPA origin, same as CORS_ALLOWED_ORIGINS):
DASHBOARD_BASE_URL=http://localhost:5173
# ── Phase 8C.1: Email delivery (SMTP) ──────────────────────────────────────
# Enable outbound transactional email. Default: false (sender becomes a no-op
# that accepts-and-discards messages — the app runs fine without SMTP
# configuration). Invitation emails (Phase 8C.3A) are queued into the
# email_outbox in the same transaction as the invitation — SMTP is NOT part
# of the request path. The background worker (Phase 8C.3B) performs the
# actual send (retry + backoff + dead-letter); the no-op sender still drains
# rows to SENT when disabled. Retention cleanup is implemented in Phase 8C.3C
# and remains opt-in.
EMAIL_ENABLED=false
# SMTP server — required when EMAIL_ENABLED=true.
# Example (starttls): smtp.example.com  |  Example (implicit TLS): smtp.example.com + SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
# SMTP AUTH credentials. AUTH is attempted only when SMTP_USERNAME is set.
SMTP_USERNAME=
SMTP_PASSWORD=
# Default sender — required when EMAIL_ENABLED=true.
# Example: "Payment Gateway <no-reply@example.com>"
SMTP_FROM=
# Transport security: starttls (default, REQUIRES server STARTTLS) |
# implicit (TLS from first byte, typically port 465) | none (dev only —
# rejected when EMAIL_ENABLED=true in production).
SMTP_TLS=starttls
# Per-send timeout (dial + handshake + submission). Default: 10s
SMTP_TIMEOUT=10s
# ── Phase 8C.3B: Email outbox worker ───────────────────────────────────────
# All defaults mirror the equivalent WEBHOOK_DELIVERY_* settings (same
# semantics, same values). The worker runs even when EMAIL_ENABLED=false so
# queued rows always drain (no-op sender → SENT).
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL=5s
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_ATTEMPTS=8
EMAIL_WORKER_STALE_AFTER=2m
# ── Phase 8C.3C: Email outbox retention cleanup ──────────────────────────────
# Deletes terminal email_outbox rows FULL-ROW: SENT older than the SENT
# retention (strict sent_at < now-retention), DEAD older than the DEAD
# retention (strict updated_at < now-retention). PENDING and PROCESSING are
# NEVER touched (delivery/retry/stale recovery stay with EMAIL_WORKER_*), and
# merchant_user_invitations is never modified — the invitation table remains
# the sole authority for invitation validity.
# Defaults encode the approved policy: 168h = 7 days, 720h = 30 days.
# Durations use Go syntax (h/m/s — NO "d" unit). Zero/negative interval,
# batch size or retention is REJECTED at startup (never "delete everything").
# Opt-in: the worker does not start until EMAIL_CLEANUP_ENABLED=true.
EMAIL_CLEANUP_ENABLED=false
EMAIL_CLEANUP_INTERVAL=1h
EMAIL_CLEANUP_BATCH_SIZE=100
EMAIL_OUTBOX_SENT_RETENTION=168h
EMAIL_OUTBOX_DEAD_RETENTION=720h
# CORS: comma-separated list of allowed origins for the React dashboard.
# Example for local development: http://localhost:5173
# Leave empty to disable CORS headers (no cross-origin access).
# NEVER use a wildcard (*) origin — credentials are not supported with wildcard origins.
# Production values, when cross-origin access is needed, must be explicit HTTPS
# origins (for example https://dashboard.example.com); HTTP localhost is development-only.
CORS_ALLOWED_ORIGINS=http://localhost:5173
