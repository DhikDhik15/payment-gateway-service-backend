# GO-SAAS backend — local staging environment TEMPLATE
#
# Copy this file to .env.stage (ignored by Git) and populate every
# <set-me> placeholder from an approved secret source. Never commit the
# populated file. The non-secret values below are safe local examples;
# replace them for any shared or internet-facing environment.
#
# This template intentionally contains no real credentials.

APP_NAME=payment-gateway
APP_ENV=test
APP_BIND_HOST=127.0.0.1
APP_PORT=18080

# Browser-facing SPA origin that serves /pay/:identifier.
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
DASHBOARD_BASE_URL=http://localhost:5173

PAYMENT_PROVIDER=mock
PAYMENT_SIMULATOR_ENABLED=true
PAYMENT_EXPIRY_ENABLED=true
PAYMENT_EXPIRY_INTERVAL=30s

# Database. Use TLS and non-local hosts for staging.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_gateway
DB_USER=<set-me>
DB_PASSWORD=<set-me>
DB_SSLMODE=require

# PostgreSQL container used by docker-compose.stage.yml.
STAGING_DB_USER=<set-me>
STAGING_DB_PASSWORD=<set-me>
STAGING_DB_NAME=payment_gateway

# Authentication and admin access.
AUTH_JWT_SECRET=<set-me: at least 32 bytes>
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
ADMIN_API_KEY=<set-me: at least 32 bytes, or leave empty to disable admin routes>

# Webhook signing and at-rest encryption.
MOCK_WEBHOOK_SECRET=<set-me: at least 32 bytes>
WEBHOOK_SECRET_ENCRYPTION_KEY=<set-me: 32 bytes as 64 hex chars or base64>
WEBHOOK_REQUIRE_HTTPS=true

# Security controls. Keep enabled for any shared environment.
RATE_LIMIT_ENABLED=true
TRUSTED_PROXIES=<set-me-or-none>

# Provider and email integrations. Leave empty unless explicitly enabled.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_ENABLED=false

# Optional complete migration URL; prefer secret-manager injection.
MIGRATION_DATABASE_URL=
