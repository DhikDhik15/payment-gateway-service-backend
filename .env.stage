# .env.stage
# Staging-only environment for GO-SAAS backend (M2A isolated local staging).
#
# This file is used with:
#   docker compose --env-file .env.stage -f docker-compose.stage.yml \
#       --project-name go-saas-m2-staging ...
#
# It is also sourced (without printing values) when starting the staging
# backend process. Do NOT commit this file. Do NOT modify the existing .env.
#
# All values are staging-only. The backend binds to 127.0.0.1:{STAGING_APP_PORT}
# and connects only to the staging PostgreSQL on 127.0.0.1:{STAGING_DB_PORT}.

# ── Staging resource identifiers ────────────────────────────────────────
STAGING_DB_PORT=55433
STAGING_APP_PORT=18080
STAGING_DB_NAME=go_saas_m2_staging
STAGING_DB_USER=go_saas_m2_staging

# ── Database (required by config.Load) ──────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=55433
DB_NAME=go_saas_m2_staging
DB_USER=go_saas_m2_staging
DB_PASSWORD=881d1f494fbdfa92a62e9286ee3dc5ba64350a20067e9691
DB_SSLMODE=disable

# ── Application ─────────────────────────────────────────────────────────
APP_NAME=payment-gateway-staging
APP_ENV=test
APP_PORT=18080
APP_BIND_HOST=127.0.0.1

# ── Provider (mock only — no live payment provider) ─────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_TIMEOUT=15s
FRONTEND_PUBLIC_URL=http://127.0.0.1:18080
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ── Idempotency / expiry ────────────────────────────────────────────────
IDEMPOTENCY_TTL=24h
PAYMENT_EXPIRY_ENABLED=false
PAYMENT_EXPIRY_INTERVAL=30s
PAYMENT_EXPIRY_BATCH_SIZE=100

# ── Webhook delivery (disabled to avoid external side effects) ──────────
WEBHOOK_DELIVERY_ENABLED=false
WEBHOOK_DELIVERY_INTERVAL=5s
WEBHOOK_DELIVERY_BATCH_SIZE=20
WEBHOOK_DELIVERY_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DELIVERY_STALE_AFTER=2m
MOCK_WEBHOOK_SECRET=6697253071744829643e10f0685fb5096269e5ada6960e885c55acca861689d9
WEBHOOK_SECRET_ENCRYPTION_KEY=19dbd68da3a61c08796b13b4f7d4edd9696fc8abb6257bd3756c1b7bd9119757
WEBHOOK_REQUIRE_HTTPS=false

# ── Rate limiting (disabled for staging test convenience) ───────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_API_PER_MINUTE=120

# ── HTTP hardening ──────────────────────────────────────────────────────
HTTP_MAX_BODY_BYTES=6291456
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# ── Trusted proxies (none — direct connections only) ────────────────────
TRUSTED_PROXIES=none

# ── Auth (test environment — insecure defaults acceptable for staging only) ─
AUTH_JWT_SECRET=b1886ef3f8d3924e0e67853955911d0a5c4844c13c41479bd77d6a7bf6d83888
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
INVITATION_TOKEN_TTL=48h
PASSWORD_RESET_TOKEN_TTL=1h

# ── Email (disabled — no SMTP side effects) ─────────────────────────────
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
SMTP_TIMEOUT=10s

# ── Admin API (required for onboarding test tenant) ─────────────────────
ADMIN_API_KEY=f5ade023c9bf6c23c7e3db4a6a83027ab550342c65b16ec6315329b9c55b8ab1
SETTLEMENT_RECON_STALE_AFTER=2m

# ── Product image uploads ───────────────────────────────────────────────
PRODUCT_IMAGE_DIR=./storage/product-images
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_DIMENSION=4096
PRODUCT_IMAGE_MAX_PIXELS=16777216

# ── Simulator (disabled by default — fail closed) ───────────────────────
PAYMENT_SIMULATOR_ENABLED=false
SIMULATOR_MERCHANT_ID=

# ── Legacy credentials (development/test default) ───────────────────────
LEGACY_API_CREDENTIALS_ENABLED=true

# ── CORS (allow Flutter web/emulator loopback origins for staging) ──────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080,http://localhost:35597

# ── Dashboard base URL (optional, email disabled) ───────────────────────
DASHBOARD_BASE_URL=

# ── Dev recovery (disabled) ─────────────────────────────────────────────
DEV_RECOVERY_ENABLED=false
DEV_RECOVERY_KEY=

# ── Migration ───────────────────────────────────────────────────────────
MIGRATION_DATABASE_URL=
STAGING_DB_PASSWORD=881d1f494fbdfa92a62e9286ee3dc5ba64350a20067e9691
